    local function GetCharacterBoundingBox(character)
        if not character then return nil end
        
        local Humanoid = character:FindFirstChild("Humanoid")
        if not Humanoid or Humanoid.Health <= 0 then return nil end
        
        local parts = {}
        for _, part in ipairs(character:GetChildren()) do
            if part:IsA("BasePart") then
                table.insert(parts, part)
            end
        end
        
        if #parts == 0 then return nil end
        
        local minX, maxX = math.huge, -math.huge
        local minY, maxY = math.huge, -math.huge
        local minZ, maxZ = math.huge, -math.huge
        
        for _, part in ipairs(parts) do
            local Size = part.Size
            local Position = part.Position
            local Right = part.CFrame.RightVector * (Size.X / 2)
            local Up = part.CFrame.UpVector * (Size.Y / 2)
            local Back = part.CFrame.LookVector * (Size.Z / 2)
            
            local vertices = {
                Position + Right + Up + Back,
                Position + Right + Up - Back,
                Position + Right - Up + Back,
                Position + Right - Up - Back,
                Position - Right + Up + Back,
                Position - Right + Up - Back,
                Position - Right - Up + Back,
                Position - Right - Up - Back
            }
            
            for _, vertex in ipairs(vertices) do
                local ScreenPos, OnScreen = Camera:WorldToViewportPoint(vertex)
                if OnScreen then
                    minX = math.min(minX, ScreenPos.X)
                    maxX = math.max(maxX, ScreenPos.X)
                    minY = math.min(minY, ScreenPos.Y)
                    maxY = math.max(maxY, ScreenPos.Y)
                    minZ = math.min(minZ, ScreenPos.Z)
                    maxZ = math.max(maxZ, ScreenPos.Z)
                end
            end
        end
        
        if minX == math.huge or maxX == -math.huge then
            return nil
        end
        
        local margin = 5
        
        return {
            Left = minX - margin,
            Right = maxX + margin,
            Top = minY - margin,
            Bottom = maxY + margin,
            DepthMin = minZ,
            DepthMax = maxZ
        }
    end

    UpdateAllESP = function()
        for _, player in ipairs(game.Players:GetPlayers()) do
            if player ~= Player then
                if not CornerBoxes[player] and not HealthBars[player] then
                    if Settings.CornerBox or Settings.HealthBar then
                        CreateESPObjects(player)
                    end
                end
            end
        end
        
        for player, lines in pairs(CornerBoxes) do
            if not player or not player.Character then
                RemoveESPObjects(player)
                continue
            end
            
            local Character = player.Character
            local Humanoid = Character:FindFirstChild("Humanoid")
            
            if not Humanoid or Humanoid.Health <= 0 then
                for _, line in ipairs(lines) do
                    line.Visible = false
                end
                if HealthBars[player] then
                    for _, line in ipairs(HealthBars[player]) do
                        line.Visible = false
                    end
                end
                continue
            end
            
            local bbox = GetCharacterBoundingBox(Character)
            if not bbox then
                for _, line in ipairs(lines) do
                    line.Visible = false
                end
                if HealthBars[player] then
                    for _, line in ipairs(HealthBars[player]) do
                        line.Visible = false
                    end
                end
                continue
            end
            
            if bbox.DepthMax < 0 then
                for _, line in ipairs(lines) do
                    line.Visible = false
                end
                if HealthBars[player] then
                    for _, line in ipairs(HealthBars[player]) do
                        line.Visible = false
                    end
                end
                continue
            end
            
            local ViewportSize = Camera.ViewportSize
            if bbox.Right < 0 or bbox.Left > ViewportSize.X or bbox.Bottom < 0 or bbox.Top > ViewportSize.Y then
                for _, line in ipairs(lines) do
                    line.Visible = false
                end
                if HealthBars[player] then
                    for _, line in ipairs(HealthBars[player]) do
                        line.Visible = false
                    end
                end
                continue
            end
            
            local LeftX = bbox.Left
            local RightX = bbox.Right
            local TopY = bbox.Top
            local BottomY = bbox.Bottom
            
            local BoxWidth = RightX - LeftX
            local BoxHeight = BottomY - TopY
            local BoxSize = math.max(BoxWidth, BoxHeight)
            
            local LineLength = math.min(math.max(BoxSize * 0.15, 5), 20)
            local thickness = math.max(1, math.min(3, BoxSize * 0.02))
            
            if Settings.CornerBox then
                lines[1].From = Vector2.new(LeftX, TopY)
                lines[1].To = Vector2.new(LeftX + LineLength, TopY)
                lines[1].Thickness = thickness
                lines[1].Visible = true
                
                lines[2].From = Vector2.new(LeftX, TopY)
                lines[2].To = Vector2.new(LeftX, TopY + LineLength)
                lines[2].Thickness = thickness
                lines[2].Visible = true
                
                lines[3].From = Vector2.new(RightX, TopY)
                lines[3].To = Vector2.new(RightX - LineLength, TopY)
                lines[3].Thickness = thickness
                lines[3].Visible = true
                
                lines[4].From = Vector2.new(RightX, TopY)
                lines[4].To = Vector2.new(RightX, TopY + LineLength)
                lines[4].Thickness = thickness
                lines[4].Visible = true
                
                lines[5].From = Vector2.new(LeftX, BottomY)
                lines[5].To = Vector2.new(LeftX + LineLength, BottomY)
                lines[5].Thickness = thickness
                lines[5].Visible = true
                
                lines[6].From = Vector2.new(LeftX, BottomY)
                lines[6].To = Vector2.new(LeftX, BottomY - LineLength)
                lines[6].Thickness = thickness
                lines[6].Visible = true
                
                lines[7].From = Vector2.new(RightX, BottomY)
                lines[7].To = Vector2.new(RightX - LineLength, BottomY)
                lines[7].Thickness = thickness
                lines[7].Visible = true
                
                lines[8].From = Vector2.new(RightX, BottomY)
                lines[8].To = Vector2.new(RightX, BottomY - LineLength)
                lines[8].Thickness = thickness
                lines[8].Visible = true
            else
                for _, line in ipairs(lines) do
                    line.Visible = false
                end
            end
            
            if Settings.HealthBar and HealthBars[player] then
                local HealthObjects = HealthBars[player]
                local BarX = LeftX - 12
                local BarWidth = 4
                local BarHeight = BoxHeight
                
                local HealthPercent = Humanoid.Health / Humanoid.MaxHealth
                HealthPercent = math.clamp(HealthPercent, 0, 1)
                
                local BarTop = TopY
                local BarBottom = BottomY
                local FillHeight = BarHeight * HealthPercent
                local FillTop = BarBottom - FillHeight
                
                local Background = HealthObjects[1]
                Background.From = Vector2.new(BarX, BarTop)
                Background.To = Vector2.new(BarX, BarBottom)
                Background.Thickness = BarWidth + 2
                Background.Visible = true
                
                local Fill = HealthObjects[2]
                Fill.From = Vector2.new(BarX, FillTop)
                Fill.To = Vector2.new(BarX, BarBottom)
                Fill.Thickness = BarWidth
                Fill.Visible = true
                
                local HealthColor
                if HealthPercent > 0.5 then
                    HealthColor = Color3.fromRGB(0, 255, 0)
                elseif HealthPercent > 0.25 then
                    HealthColor = Color3.fromRGB(255, 255, 0)
                else
                    HealthColor = Color3.fromRGB(255, 0, 0)
                end
                Fill.Color = HealthColor
            elseif HealthBars[player] then
                for _, line in ipairs(HealthBars[player]) do
                    line.Visible = false
                end
            end
        end
    end

