    -- Converter posição 3D para coordenadas 2D na tela
    local function WorldToScreen(WorldPosition)
        if not WorldPosition then return nil end
        
        local ScreenPos, OnScreen = Camera:WorldToScreenPoint(WorldPosition)
        if not OnScreen then return nil end
        
        local CameraPos = Camera.CFrame.Position
        local Direction = (WorldPosition - CameraPos).Unit
        local LookDirection = Camera.CFrame.LookVector
        
        if Direction:Dot(LookDirection) < 0 then
            return nil
        end
        
        return Vector2.new(ScreenPos.X, ScreenPos.Y)
    end

    -- Verificar se alvo está dentro do FOV
    local function IsTargetInFOV(TargetPosition)
        if not TargetPosition then return false end
        
        local ScreenPos = WorldToScreen(TargetPosition)
        if not ScreenPos then return false end
        
        local Center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
        local Distance = (ScreenPos - Center).Magnitude
        
        return Distance <= FOVRadius
    end

    -- Calcular distância do centro do FOV
    local function GetDistanceFromFOVCenter(TargetPosition)
        if not TargetPosition then return math.huge end
        
        local ScreenPos = WorldToScreen(TargetPosition)
        if not ScreenPos then return math.huge end
        
        local Center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
        return (ScreenPos - Center).Magnitude
    end

    -- Encontrar o melhor alvo
    local function FindBestTarget()
        if not Settings.Aimbot then return nil end
        
        local Character = Player.Character
        if not Character or not Character:FindFirstChild("Head") then return nil end
        
        local BestTarget = nil
        local BestDistance = math.huge
        
        for _, Target in ipairs(game.Players:GetPlayers()) do
            if Target ~= Player then
                local TargetHead = Target.Character and Target.Character:FindFirstChild("Head")
                local TargetHumanoid = Target.Character and Target.Character:FindFirstChild("Humanoid")
                
                if TargetHead and TargetHumanoid and TargetHumanoid.Health > 0 then
                    local TargetPos = TargetHead.Position
                    
                    if IsTargetInFOV(TargetPos) then
                        local Distance = GetDistanceFromFOVCenter(TargetPos)
                        if Distance < BestDistance then
                            BestDistance = Distance
                            BestTarget = Target
                        end
                    end
                end
            end
        end
        
        return BestTarget
    end

    -- Aplicar suavidade ao movimento da câmera
    local function ApplySmoothness(TargetCFrame)
        if not TargetCFrame then return end
        
        local SmoothFactor = math.clamp(Settings.Smoothness / 10, 0.1, 1)
        local CurrentCFrame = Camera.CFrame
        local SmoothCFrame = CurrentCFrame:Lerp(TargetCFrame, SmoothFactor)
        
        Camera.CFrame = SmoothCFrame
    end

    -- Lógica principal do Aimbot
